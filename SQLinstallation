---
- name: Install SQL Server 2019 using ConfigurationFile.ini
  hosts: mssql
  gather_facts: false
  serial: 1

  vars:
    sql_setup_path: "{{ lookup('env', 'SQL_SETUP_PATH') }}"
    sql_configuration_file: "{{ lookup('env', 'SQL_CONFIGURATION_FILE') }}"

  tasks:

    - name: Verify SQL Server setup exists
      ansible.windows.win_stat:
        path: "{{ sql_setup_path }}"
      register: setup_file

    - name: Fail if setup.exe is missing
      ansible.builtin.fail:
        msg: "SQL Server setup.exe not found: {{ sql_setup_path }}"
      when: not setup_file.stat.exists

    - name: Verify configuration file exists
      ansible.windows.win_stat:
        path: "{{ sql_configuration_file }}"
      register: config_file

    - name: Fail if configuration file is missing
      ansible.builtin.fail:
        msg: "Configuration file not found: {{ sql_configuration_file }}"
      when: not config_file.stat.exists

    - name: Install SQL Server 2019
      ansible.windows.win_command: >
        "{{ sql_setup_path }}"
        /ConfigurationFile="{{ sql_configuration_file }}"
        /UpdateEnabled=False
        /IACCEPTSQLSERVERLICENSETERMS
      register: sql_install_result
      changed_when: sql_install_result.rc in [0, 3010]
      failed_when: sql_install_result.rc not in [0, 3010]
      check_mode: no

    - name: Display installation result
      ansible.builtin.debug:
        var: sql_install_result

    - name: Check if SQL Server service exists
      ansible.windows.win_shell: |
        Get-Service MSSQLSERVER -ErrorAction SilentlyContinue
      register: sql_service
      changed_when: false

    - name: Display SQL Server service
      ansible.builtin.debug:
        var: sql_service.stdout_lines

    - name: Verify SQL Server version
      ansible.windows.win_shell: |
        sqlcmd -Q "SET NOCOUNT ON; SELECT @@VERSION;"
      register: sql_version
      changed_when: false
      failed_when: false
      check_mode: no

    - name: Display SQL Server version
      ansible.builtin.debug:
        var: sql_version.stdout_lines---
