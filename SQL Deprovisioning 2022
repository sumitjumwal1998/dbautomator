---
- name: Uninstall SQL Server 2019 using ConfigurationFile.ini
  hosts: mssql
  gather_facts: false
  serial: 1

  vars:
    sql_setup_path: "{{ lookup('env', 'SQL_SETUP_PATH') }}"
    sql_configuration_file: "{{ lookup('env', 'SQL_CONFIGURATION_FILE') }}"

  tasks:

    - name: Verify SQL Server setup exists
      ansible.windows.win_stat:
        path: "{{ sql_setup_path }}"
      register: setup_file

    - name: Fail if setup.exe is missing
      ansible.builtin.fail:
        msg: "SQL Server setup.exe not found: {{ sql_setup_path }}"
      when: not setup_file.stat.exists


    - name: Verify uninstall configuration file exists
      ansible.windows.win_stat:
        path: "{{ sql_configuration_file }}"
      register: config_file

    - name: Fail if configuration file is missing
      ansible.builtin.fail:
        msg: "SQL Server uninstall configuration file not found: {{ sql_configuration_file }}"
      when: not config_file.stat.exists


    - name: Uninstall SQL Server
      ansible.windows.win_command: >
        "{{ sql_setup_path }}"
        /ConfigurationFile="{{ sql_configuration_file }}"
        /Q
        /IACCEPTSQLSERVERLICENSETERMS
      register: uninstall_result
      changed_when: uninstall_result.rc in [0,3010]
      failed_when: uninstall_result.rc not in [0,3010]
      check_mode: no


    - name: Display uninstall result
      ansible.builtin.debug:
        var: uninstall_result


    - name: Verify SQL Server service removed
      ansible.windows.win_shell: |
        Get-Service -Name MSSQL* -ErrorAction SilentlyContinue
      register: sql_service_check
      changed_when: false
      failed_when: false
      check_mode: no


    - name: Display remaining SQL services
      ansible.builtin.debug:
        var: sql_service_check.stdout_lines
